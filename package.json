{
  "name": "tram-ke",
  "private": true,
  "description": "Build and toolchain only. The app itself has no JavaScript dependencies; runtime/ is the port boundary and everything under src/ is Elm.",
  "scripts": {
    "start": "vite",
    "check": "elm make src/Main.elm --output=/dev/null && tsc --noEmit",
    "format": "elm-format --validate src/ tests/",
    "test": "elm-test",
    "structure": "python3 devops/check.py",
    "build": "devops/build.sh"
  },
  "devDependencies": {
    "elm": "0.19.2-0",
    "elm-format": "0.8.8",
    "elm-test": "0.19.2-0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-elm-watch": "2.0.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "type": "module"
}
